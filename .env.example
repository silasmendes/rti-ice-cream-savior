# Choose one: connection_string (SAS key) or azure_cli (your Entra account).
# Restart the Flask process after changing this file.
EVENT_HUB_AUTH_MODE=connection_string

# Required for both modes: the Event Hub name, not the namespace name.
EVENT_HUB_NAME=

# SAS only: paste the complete connection string from a policy with Send rights.
# Ignored in azure_cli mode. SAS/local authentication must be enabled in Azure.
EVENT_HUB_CONNECTION_STRING=

# Entra only: run az login first. Your account needs Azure Event Hubs Data Sender.
# Ignored in connection_string mode. Hostname only, without sb:// or a trailing slash.
EVENT_HUB_FULLY_QUALIFIED_NAMESPACE=
